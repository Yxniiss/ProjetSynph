{% extends 'base.html.twig' %}

{% block title %}Contact{% endblock %}

{% block body %}
<h1>Contactez-nous</h1>

{% for message in app.flashes('success') %}
    <div style="color:green;">{{ message }}</div>
{% endfor %}

{{ form_start(form) }}
    {{ form_row(form.name) }}
    {{ form_row(form.email) }}
    {{ form_row(form.message) }}
    <button type="submit">Envoyer</button>
{{ form_end(form) }}
{% endblock %}
